{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SURGE Language State",
  "type": "object",
  "required": ["schema_version", "revision", "hypotheses", "candidate_sets"],
  "properties": {
    "schema_version": { "const": 1 },
    "revision": { "type": "integer", "minimum": 0 },
    "hypotheses": {
      "type": "array", "maxItems": 32,
      "items": {
        "type": "object",
        "required": ["id", "span", "surface", "status", "score", "confidence"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "span": { "$ref": "#/$defs/span" },
          "surface": { "type": "string", "maxLength": 191 },
          "interpretation": { "type": "string", "maxLength": 47 },
          "score": { "type": "number" },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "created_revision": { "type": "integer", "minimum": 0 },
          "valid_until_revision": { "type": "integer", "minimum": 0 },
          "status": { "enum": ["active", "deferred", "selected", "rejected", "expired"] }
        },
        "additionalProperties": false
      }
    },
    "candidate_sets": {
      "type": "array", "maxItems": 16,
      "items": {
        "type": "object",
        "required": ["id", "span", "hypothesis_ids"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "span": { "$ref": "#/$defs/span" },
          "hypothesis_ids": { "type": "array", "minItems": 1, "maxItems": 8, "uniqueItems": true, "items": { "$ref": "#/$defs/id" } }
        },
        "additionalProperties": false
      }
    },
    "semantic_frames": { "type": "array", "maxItems": 16 },
    "syntax_relations": { "type": "array", "maxItems": 64 },
    "orthographic_hypotheses": { "type": "array", "maxItems": 32 },
    "entities": { "type": "array", "maxItems": 16 },
    "evidence": {
      "type": "array", "maxItems": 64,
      "items": {
        "type": "object",
        "required": ["id", "hypothesis_id", "kind", "source", "score", "confidence", "valid_from_revision"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "hypothesis_id": { "$ref": "#/$defs/id" },
          "kind": { "enum": ["lexical", "ngram", "part_of_speech", "morphological", "syntactic", "semantic", "discourse", "entity", "orthographic", "user_policy"] },
          "source": { "type": "string", "maxLength": 47 },
          "score": { "type": "number" },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "valid_from_revision": { "type": "integer", "minimum": 0 },
          "valid_until_revision": { "type": "integer", "minimum": 0 },
          "dependency_ids": { "type": "array", "maxItems": 4, "uniqueItems": true, "items": { "$ref": "#/$defs/id" } }
        },
        "additionalProperties": false
      }
    },
    "constraints": { "type": "array", "maxItems": 32 },
    "decisions": { "type": "array", "maxItems": 32 },
    "revisions": { "type": "array", "maxItems": 32 },
    "commit_spans": { "type": "array", "maxItems": 16 }
  },
  "$defs": {
    "id": { "type": "string", "minLength": 1, "maxLength": 63, "pattern": "^[^\\u0000]*$" },
    "span": {
      "type": "object",
      "required": ["start", "end"],
      "properties": {
        "start": { "type": "integer", "minimum": 0, "maximum": 65534 },
        "end": { "type": "integer", "minimum": 1, "maximum": 65535 }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
